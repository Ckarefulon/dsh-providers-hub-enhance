{
  "name": "dsh-providers-hub-enhance",
  "version": "1.3.0",
  "description": "给 dsh-providers-hub 打增强补丁：CodeBuddy 出站守卫（11128 不再拦）+ Raccoon（商汤小浣熊）每日签到 + 限流中断后的「解禁后自动继续」+ 账号「临期置顶」开关。可重放、可还原、带守卫的 node_modules 补丁器",
  "type": "module",
  "bin": {
    "dsh-providers-hub-enhance": "./patch.mjs"
  },
  "exports": {
    ".": "./patch.mjs",
    "./patch-data.json": "./patch-data.json"
  },
  "files": [
    "patch.mjs",
    "patch-data.json",
    "assets",
    "docs",
    "scripts",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "patch": "node patch.mjs",
    "check": "node patch.mjs --check",
    "revert": "node patch.mjs --revert",
    "sync-hashes": "node scripts/sync-hashes.mjs",
    "verify": "node scripts/verify-guard.mjs",
    "test": "node --experimental-vm-modules tests/patch.test.mjs && node tests/rate-limit-resume.test.mjs && node tests/client-rate-limit.test.mjs && node tests/expiry-first.test.mjs && node tests/codebuddy-guard.test.mjs && node --experimental-vm-modules tests/syntax-check.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-providers-hub",
    "codebuddy",
    "workbuddy",
    "tencent",
    "11128",
    "fetch-guard",
    "dsh-wb400-guard",
    "raccoon",
    "sensetime",
    "xiaohuanxiong",
    "小浣熊",
    "每日签到",
    "rate-limit",
    "限流",
    "auto-continue",
    "expiry-order",
    "临期排序",
    "expiry-first",
    "临期置顶",
    "patch"
  ],
  "author": "Careful S. (Ckarefulon)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ckarefulon/dsh-providers-hub-enhance.git"
  },
  "bugs": {
    "url": "https://github.com/Ckarefulon/dsh-providers-hub-enhance/issues"
  },
  "homepage": "https://github.com/Ckarefulon/dsh-providers-hub-enhance#readme"
}
